# Copie para .env (não commitado) e preencha. Usado por docker-compose.yml.

# Quick start local sem nenhuma credencial: deixe tudo abaixo em branco e
# descomente a linha seguinte. O dashboard sobe com um banner de aviso e o
# compose já publica a porta só em 127.0.0.1 (ver docker-compose.yml).
# DASHBOARD_DEV_MODE=true

# OAuth App do GitHub (Settings > Developer settings > OAuth Apps).
# Callback URL cadastrada no App deve ser {DASHBOARD_BASE_URL}/auth/callback.
# Obrigatório para rodar sem DASHBOARD_DEV_MODE=true.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# String aleatória longa (ex.: openssl rand -base64 32) — assina o cookie
# de sessão. Trocar invalida todas as sessões ativas.
SESSION_SECRET=

# Organização GitHub cuja filiação dá acesso ao dashboard.
GITHUB_ORG=

# URL pública onde o dashboard fica acessível (sem barra final).
DASHBOARD_BASE_URL=http://localhost:3000

# Credencial de leitura do poller — App token de curta duração (gerado por
# fora, ex. um cron que renova) OU um PAT fine-grained. Nenhum dos dois é
# obrigatório: sem nenhum, o poller usa a API pública não-autenticada
# (60 req/h, só repositórios públicos).
PR_REGISTRY_APP_TOKEN=
PR_REGISTRY_PAT=

# Chave da API Anthropic — sem ela, todo registro é gerado em modo
# degradado (não bloqueia o serviço, só reduz a qualidade dos registros).
ANTHROPIC_API_KEY=
