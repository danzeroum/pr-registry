[
  {
    "nome": "aws_access_key_id",
    "regex": "AKIA[0-9A-Z]{16}",
    "flags": "g"
  },
  {
    "nome": "github_token",
    "regex": "gh[pousr]_[A-Za-z0-9]{36,}",
    "flags": "g"
  },
  {
    "nome": "jwt",
    "regex": "eyJ[A-Za-z0-9_-]+\\.eyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+",
    "flags": "g"
  },
  {
    "nome": "private_key_block",
    "regex": "-----BEGIN [A-Z ]*PRIVATE KEY-----[\\s\\S]*?-----END [A-Z ]*PRIVATE KEY-----",
    "flags": "g"
  },
  {
    "nome": "generic_assignment_secret",
    "regex": "\\b(password|senha|secret|token|api[_-]?key|apikey)\\b\\s*[:=]\\s*['\"]?[^\\s'\"]{4,}['\"]?",
    "flags": "gi"
  },
  {
    "nome": "connection_string",
    "regex": "[a-zA-Z][a-zA-Z0-9+.-]*://[^\\s:@/]+:[^\\s:@/]+@[^\\s'\"]+",
    "flags": "g"
  },
  {
    "nome": "slack_token",
    "regex": "xox[baprs]-[A-Za-z0-9-]{10,}",
    "flags": "g"
  }
]
