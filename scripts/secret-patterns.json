[
  {
    "nome": "aws_access_key_id",
    "regex": "AKIA[0-9A-Z]{16}",
    "flags": "g"
  },
  {
    "nome": "github_token",
    "regex": "gh[pousr]_[A-Za-z0-9]{36,}",
    "flags": "g"
  },
  {
    "nome": "jwt",
    "regex": "eyJ[A-Za-z0-9_-]+\\.eyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+",
    "flags": "g"
  },
  {
    "nome": "private_key_block",
    "regex": "-----BEGIN [A-Z ]*PRIVATE KEY-----[\\s\\S]*?-----END [A-Z ]*PRIVATE KEY-----",
    "flags": "g"
  },
  {
    "nome": "generic_assignment_secret",
    "regex": "[A-Za-z0-9_]*(?:password|senha|secret|token|api[_-]?key|apikey|credential)[A-Za-z0-9_]*\\s*[:=]\\s*['\"`]?[^\\s'\"`,;]{4,}['\"`]?",
    "flags": "gi"
  },
  {
    "nome": "connection_string",
    "regex": "[a-zA-Z][a-zA-Z0-9+.-]*://[^\\s:@/]+:[^\\s:@/]+@[^\\s'\"]+",
    "flags": "g"
  },
  {
    "nome": "slack_token",
    "regex": "xox[baprs]-[A-Za-z0-9-]{10,}",
    "flags": "g"
  },
  {
    "nome": "anthropic_api_key",
    "regex": "sk-ant-[A-Za-z0-9_-]{20,}",
    "flags": "g"
  },
  {
    "nome": "openai_api_key",
    "regex": "sk-(proj-)?[A-Za-z0-9]{20,}",
    "flags": "g"
  },
  {
    "nome": "stripe_key",
    "regex": "(sk|pk)_(live|test)_[A-Za-z0-9]{16,}",
    "flags": "g"
  },
  {
    "nome": "google_api_key",
    "regex": "AIza[0-9A-Za-z_-]{35}",
    "flags": "g"
  },
  {
    "nome": "bearer_token",
    "regex": "Bearer\\s+[A-Za-z0-9\\-_.=]{16,}",
    "flags": "g"
  }
]
